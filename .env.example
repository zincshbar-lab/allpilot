# NEAR AI Cloud (https://cloud.near.ai) — leave empty to run the offline command parser
NEAR_AI_API_KEY=
NEAR_AI_MODEL=deepseek/deepseek-v4.1-flash
# NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1

# Optional NEAR Intents 1Click partner JWT (https://partners.near-intents.org) — removes the 0.2% fee
ONECLICK_JWT=

# Optional comma-separated mainnet RPC list
# NEAR_RPC_URLS=https://free.rpc.fastnear.com,https://rpc.shitzuapes.xyz,https://near.drpc.org

# Base URL for payment links when deployed (defaults to the request origin)
# PUBLIC_SITE_URL=https://allpilot.example
